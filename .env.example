# Test credentials — copy to .env and fill in real values.
# Never commit .env to version control.

API_BASE=http://localhost:8086
GTFS_BASE=http://localhost:8087

# Login credentials for authoritative (token) mode tests
TEST_AGENCY_CODE=<agency-code>
TEST_EMPLOYEE_ID=<employee-id>
TEST_PIN=<pin>

# UUIDs used by the test scripts
AGENCY_ID=<agency-uuid>
VEHICLE_ID=<vehicle-uuid>
TRIP_ID=<trip-uuid>
